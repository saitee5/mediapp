# ==============================================================================
# MediScribe AI Agent Environment Configuration
# ==============================================================================

# 1. LLM API Keys (Provide Google AI Studio key OR Groq key)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Optional Vertex AI location (if using Google Cloud ADC instead of API key)
DEFAULT_VERTEX_LOCATION=global

# 2. Supabase Database & Storage Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_STORAGE_BUCKET=case-sheets

# 3. Optional Groq Configuration (for fast Whisper audio transcription)
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_WHISPER_MODEL=whisper-large-v3-turbo

# 4. Server settings
PORT=8000
HOST=0.0.0.0
ENV=development
DEBUG=true
